---
// One problem's detail entry — the AtomDetail design, problem-native.
// Two realization columns per corpus (CORPUS_COLUMNS): column A is the
// ground-truth side (webppl, or posteriordb gold reference draws — stored, no
// code), column B is the realization cross-checked against A (pyro, or stan).
import type { ProblemRecord, GtAnswerRow, Rollout } from '@/lib/problems';
import { specChip, problemChapter, problemLeaf, canonicalToRenderOutput, CORPUS_COLUMNS } from '@/lib/problems';
import type { Corpus } from '@/lib/problems';
import { statusLabel } from '@/lib/tones';
import { renderCode, renderChart, renderRecordOverlay, renderValueOutput, isDistLike, atomDomId, escapeHtml } from '@/lib/render';
import type { RenderOutput } from '@/lib/types';

interface Props {
  record: ProblemRecord;
  gtAnswers: Record<string, GtAnswerRow> | undefined;
  rollouts?: Rollout[];
  corpus: string;
}
const { record, gtAnswers, rollouts = [], corpus } = Astro.props;
const { problem, realizationA, realizationB, gateA, gateB, crosscheck } = record;
const pid = problem.problem_id;
const cols = CORPUS_COLUMNS[corpus as Corpus];

const chip = specChip(problem.answer_spec);
const aOut = canonicalToRenderOutput(gtAnswers?.[cols.a.lang]?.answer) as RenderOutput;
const bOut = canonicalToRenderOutput(gtAnswers?.[cols.b.lang]?.answer) as RenderOutput;
const isRecord = (o: RenderOutput): o is { kind: 'record'; fields: Record<string, RenderOutput> } =>
  !!o && o.kind === 'record';

// tone mapping for the original bucket-badge classes (great/good/poor/bad/na)
function gateTone(status: string | undefined): string {
  if (!status) return 'na';
  if (status === 'accept' || status === 'pass' || status === 'ok') return 'great';
  if (status === 'gt_suspect' || status === 'underdetermined') return 'poor';
  if (status === 'draft') return 'ok';
  if (status === 'reviewed') return 'good';
  if (status === 'unavailable') return 'na';  // documented gap, not a failure
  return 'bad';
}
const solverTone = gateTone(gateB?.status);
const crossTone = gateTone(crosscheck?.status);

function fmt(v: number | undefined | null): string {
  return v == null ? '—' : v.toFixed(4);
}

// A Stan realization is a bundle whose `//@ DATA {...}` directive embeds the full
// dataset (for diamonds, an N×25 matrix — megabytes). The data is runtime input,
// not model code, so the displayed/shipped code summarizes it; the full bundle
// stays in stan.jsonl for execution. No-op for non-bundle code (webppl/pyro).
function summarizeStanData(code: string): string {
  return code.replace(/^(\/\/@ DATA )(.*)$/m, (_m, pre, json) => {
    try {
      const d = JSON.parse(json) as Record<string, unknown>;
      const parts = Object.entries(d).map(([k, v]) => {
        if (Array.isArray(v)) {
          return Array.isArray(v[0]) ? `${k}: [${v.length}×${(v[0] as unknown[]).length} matrix]` : `${k}: [${v.length} values]`;
        }
        if (v && typeof v === 'object') return `${k}: {…}`;
        return `${k}: ${JSON.stringify(v)}`;
      });
      return `${pre}{ ${parts.join(', ')} }   // values supplied at runtime`;
    } catch {
      return `${pre}{ … }   // values supplied at runtime`;
    }
  });
}

interface SourceData {
  key: string; lang: string; label: string; short: string; codeLang: string | null;
  code: string; output: RenderOutput; tv: number | null;
  unavailable: boolean; reason: string; storedGt: string;
}
const srcA: SourceData = {
  key: 'gt', lang: cols.a.lang, label: cols.a.label, short: cols.a.short, codeLang: cols.a.codeLang,
  code: summarizeStanData(realizationA?.code ?? ''), output: aOut, tv: null,
  unavailable: realizationA?.available === false, reason: realizationA?.reason ?? '',
  storedGt: cols.a.storedGt ?? '',
};
const srcB: SourceData = {
  key: cols.b.lang, lang: cols.b.lang, label: cols.b.label, short: cols.b.short, codeLang: cols.b.codeLang,
  code: summarizeStanData(realizationB?.code ?? ''), output: bOut, tv: crosscheck?.distance ?? null,
  unavailable: realizationB?.available === false, reason: realizationB?.reason ?? '',
  storedGt: cols.b.storedGt ?? '',
};

function unavailableHtml(short: string, reason: string): string {
  return (
    `<div class="compare-unavailable">` +
      `<div class="compare-unavailable-hd">unavailable in ${escapeHtml(short)}</div>` +
      `<p class="compare-unavailable-reason">${escapeHtml(reason)}</p>` +
    `</div>`
  );
}

function storedGtHtml(description: string): string {
  return (
    `<div class="compare-stored">` +
      `<div class="compare-stored-hd">stored ground truth</div>` +
      `<p class="compare-stored-body">${escapeHtml(description)}</p>` +
    `</div>`
  );
}

// Render one source's column body. Single source of truth: the server renders the
// initial grid with it AND embeds it in sourcePayload, so browse.js reuses it on
// source-switch rather than re-implementing the branches.
function srcBodyHtml(src: SourceData): string {
  if (src.unavailable) return unavailableHtml(src.short, src.reason);
  if (src.codeLang === null) return storedGtHtml(src.storedGt);   // stored-GT column (reference)
  if (src.code) return renderCode(src.code, src.codeLang);
  return `<div class="out-empty">(no ${escapeHtml(src.short)} realization)</div>`;
}

function fmtTV(n: number | null | undefined): string {
  if (n == null) return '';
  if (n === 0) return '0.000';
  if (n < 0.001) return n.toExponential(1);
  return n.toFixed(3);
}
interface Badge { tone: string; glyph: string; label: string }
function badgeHtmlServer(badge: Badge, tv: number | null): string {
  const tvBit = tv != null ? `<span class="bucket-tv">${fmtTV(tv)}</span>` : '';
  return `<span class="bucket bucket-${badge.tone} bucket-sm">` +
    `<span class="bucket-glyph">${badge.glyph}</span>` +
    `<span class="bucket-label">${escapeHtml(badge.label)}</span>` + tvBit +
  `</span>`;
}

// Answer overlay (section 02). Records → per-parameter small multiples; single
// distributions → the mirrored overlay; scalar values → side-by-side values.
let chartSectionHtml = '';
if (isRecord(aOut) || isRecord(bOut)) {
  chartSectionHtml = (
    `<div class="compare-chart">` +
      `<div class="section-title">` +
        `<span class="section-title-num">02</span>` +
        `<span>answer overlay — ${escapeHtml(cols.a.short)} vs ${escapeHtml(cols.b.short)}</span>` +
        `<span class="section-title-meta">${escapeHtml(chip)}</span>` +
      `</div>` +
      renderRecordOverlay({ a: aOut, b: bOut, labelA: cols.a.short, labelB: cols.b.short }) +
    `</div>`
  );
} else if (isDistLike(aOut) || isDistLike(bOut)) {
  chartSectionHtml = (
    `<div class="compare-chart">` +
      `<div class="section-title">` +
        `<span class="section-title-num">02</span>` +
        `<span>answer overlay — ${escapeHtml(cols.a.short)} vs ${escapeHtml(cols.b.short)}</span>` +
        `<span class="section-title-meta">${escapeHtml(chip)}</span>` +
      `</div>` +
      renderChart({
        a: isDistLike(aOut) ? aOut : null,
        b: isDistLike(bOut) ? bOut : null,
        labelA: cols.a.short, labelB: cols.b.short,
      }) +
    `</div>`
  );
} else if (aOut || bOut) {
  chartSectionHtml = (
    `<div class="compare-chart">` +
      `<div class="section-title">` +
        `<span class="section-title-num">02</span>` +
        `<span>answer</span>` +
        `<span class="section-title-meta">${escapeHtml(chip)}</span>` +
      `</div>` +
      `<div class="compare-grid">` +
        `<div class="compare-col"><div class="compare-col-hd"><span class="compare-col-tag tag-a">${escapeHtml(cols.a.short)}</span></div>${renderValueOutput(aOut)}</div>` +
        `<div class="compare-col"><div class="compare-col-hd"><span class="compare-col-tag tag-b">${escapeHtml(cols.b.short)}</span></div>${renderValueOutput(bOut, `(no ${escapeHtml(cols.b.short)} answer export)`)}</div>` +
      `</div>` +
    `</div>`
  );
}

// payload for browse.js source switching. Available code columns carry raw `code`
// + `codeLang` (browse.js highlights on switch); stored-GT and unavailable columns
// carry the server-rendered body (single source, no payload bloat).
const payloadEntry = (src: SourceData) => ({
  short: src.short, label: src.label, output: src.output, tv: src.tv,
  ...((src.unavailable || src.codeLang === null)
    ? { bodyHtml: srcBodyHtml(src) }
    : { code: src.code, codeLang: src.codeLang }),
});
// Status → badge (tone/glyph/label). The badge object travels in each payload
// entry so browse.js can re-render it on source-switch without a parallel map.
function statusBadge(status: string, tone: string): Badge {
  const G: Record<string, string> = { pass: '✓', fail: '✗', malformed: '⚠', ill_posed: '⚠', exec_error: '∅' };
  const L: Record<string, string> = { pass: 'pass', fail: 'fail', malformed: 'malformed', ill_posed: 'ill-posed', exec_error: 'exec error' };
  return { tone, glyph: G[status] ?? '·', label: L[status] ?? status };
}
function rolloutTone(status: string): string {
  if (status === 'pass') return 'great';
  if (status === 'fail') return 'bad';
  if (status === 'ill_posed' || status === 'malformed') return 'poor';
  return 'na'; // exec_error
}
const gtBadge: Badge = { tone: 'na', glyph: '◆', label: 'ground truth' };
const realBadge: Badge = { tone: crossTone, glyph: '◆', label: 'realization' };

const sourcePayload: Record<string, unknown> = {
  gt: { ...payloadEntry(srcA), badge: gtBadge },
  [srcB.key]: { ...payloadEntry(srcB), badge: realBadge },
};

// ── Model rollouts as additional compare sources ──
// Each (model, language) rollout becomes a selectable source: its generated code
// + a pass/fail badge, comparable against the GT in the same language. Surfaced
// only in the corpus's solver language (webppl corpora → webppl; posteriordb → stan).
const LANG_INFO: Record<string, { short: string; codeLang: string }> = {};
for (const c of [cols.a, cols.b]) if (c.codeLang) LANG_INFO[c.lang] = { short: c.short, codeLang: c.codeLang };

interface OrderedSource { key: string; opt: string }
const orderedSources: OrderedSource[] = [
  { key: 'gt', opt: `${cols.a.short} · ground truth` },
  { key: srcB.key, opt: `${cols.b.short} · realization` },
];
for (const r of rollouts) {
  if (r.language !== cols.solverLang) continue;
  const info = LANG_INFO[r.language];
  if (!info) continue;
  const key = `${r.model}@${r.language}`;
  sourcePayload[key] = {
    short: r.model, label: `${r.model} · ${info.short} rollout`,
    output: r.answer ? canonicalToRenderOutput(r.answer) : null,
    tv: r.distance, badge: statusBadge(r.status, rolloutTone(r.status)),
    code: r.code, codeLang: info.codeLang,
    ...(r.error ? { error: r.error } : {}),
    ...(r.error_tag ? { errorTag: r.error_tag } : {}),
  };
  const dBit = r.distance != null ? ` (d=${fmtTV(r.distance)})` : '';
  const tagBit = (r.status !== 'pass' && r.error_tag) ? ` [${r.error_tag}]` : '';
  orderedSources.push({ key, opt: `${r.model} · ${statusLabel(r.status)}${dBit}${tagBit}` });
}

// Compare columns: each header is a custom parchment dropdown (NOT a native
// <select>, which leaks system styling) over ALL sources — left = A, right = B,
// both pickable from one unified list. browse.js swaps the body + badge on pick;
// the legacy /c/ pill path is untouched (it has no data-col-body).
function menuHtml(selectedKey: string): string {
  return orderedSources.map((o) =>
    `<button type="button" class="src-menu-item${o.key === selectedKey ? ' src-menu-item-on' : ''}" data-src-opt="${escapeHtml(o.key)}">${escapeHtml(o.opt)}</button>`
  ).join('');
}
function colHtml(side: 'a' | 'b', src: SourceData, selectedKey: string, badge: Badge, tv: number | null): string {
  const selOpt = orderedSources.find((o) => o.key === selectedKey)?.opt ?? selectedKey;
  return `<div class="compare-col">` +
    `<div class="compare-col-hd compare-col-pick">` +
      `<div class="src-picker" data-src-picker="${side}">` +
        `<button type="button" class="src-toggle" data-src-toggle aria-expanded="false" aria-label="${side === 'a' ? 'left' : 'right'} compare source">` +
          `<span class="src-toggle-label" data-src-toggle-label>${escapeHtml(selOpt)}</span>` +
          `<span class="src-caret">▾</span>` +
        `</button>` +
        `<div class="src-menu" data-src-menu hidden>${menuHtml(selectedKey)}</div>` +
      `</div>` +
      `<span class="compare-col-badge" data-col-badge="${side}">${badgeHtmlServer(badge, tv)}</span>` +
    `</div>` +
    `<div class="compare-col-body" data-col-body="${side}">${srcBodyHtml(src)}</div>` +
  `</div>`;
}
const compareGridHtml =
  colHtml('a', srcA, 'gt', gtBadge, null) +
  colHtml('b', srcB, srcB.key, realBadge, crosscheck?.distance ?? null);

const hasPrimer = cols.primer != null;
---

<section class="detail" id={atomDomId(pid)} data-aid={pid}>
  <div class="detail-hd">
    <div class="detail-hd-top">
      <div class="detail-hd-id">
        <span class="detail-hd-source">{corpus}-{problemChapter(pid)}</span>
        <span class="detail-hd-slash">/</span>
        <span class="detail-hd-name">{problemLeaf(pid)}</span>
      </div>
      <div class="detail-hd-meta">
        <span class="meta-pill">
          <span class="meta-pill-key">answer</span>
          <span class="meta-pill-val">{chip}</span>
        </span>
        {cols.hasSolverGate && (
          <span class="meta-pill" title="solver re-derivation gate">
            <span class="meta-pill-key">solver</span>
            <span class={`bucket bucket-${solverTone} bucket-sm`}>
              <span class="bucket-label">{gateB ? statusLabel(gateB.status) : '—'}</span>
            </span>
          </span>
        )}
        <span class="meta-pill" title={`cross-language gate (${cols.b.short} vs ${cols.a.short} GT)`}>
          <span class="meta-pill-key">{cols.b.short}</span>
          <span class={`bucket bucket-${crossTone} bucket-sm`}>
            <span class="bucket-label">{crosscheck ? statusLabel(crosscheck.status) : '—'}</span>
            {crosscheck?.distance != null && <span class="bucket-tv">{fmt(crosscheck.distance)}</span>}
          </span>
        </span>
      </div>
    </div>

  </div>

  <section class="detail-section">
    <div class="section-title">
      <span class="section-title-num">00</span>
      <span>statement</span>
      <span class="section-title-meta">source: <code>{problem.provenance.source}</code></span>
    </div>
    <div class="prompt-card">
      <div class="stmt-field-hd">given</div>
      <p>{problem.statement.given}</p>
      <div class="stmt-field-hd">model</div>
      <p>{problem.statement.model}</p>
      <div class="stmt-field-hd">query</div>
      <p>{problem.statement.query}</p>
    </div>
    <div class="context-row">
      <details class="collapse">
        <summary>
          <span class="collapse-title">answer spec</span>
          <span class="collapse-meta">{chip}</span>
        </summary>
        <div class="collapse-body"><pre class="ctx-pre">{JSON.stringify(problem.answer_spec, null, 2)}</pre></div>
      </details>
      <details class="collapse">
        <summary>
          <span class="collapse-title">system prompt</span>
          <span class="collapse-meta">constant across problems</span>
        </summary>
        <div class="collapse-body"><pre class="ctx-pre" data-sysprompt-placeholder>(system prompt loads here)</pre></div>
      </details>
      {hasPrimer && (
        <details class="collapse">
          <summary>
            <span class="collapse-title">{cols.primer} primer</span>
            <span class="collapse-meta">solver context</span>
          </summary>
          <div class="collapse-body"><pre class="ctx-pre" data-primer-placeholder>(primer loads here)</pre></div>
        </details>
      )}
    </div>
  </section>

  <section class="detail-section">
    <div class="section-title">
      <span class="section-title-num">01</span>
      <span>realizations</span>
      <span class="section-title-meta">comparing <code data-ab-label-a>{cols.a.short}</code> vs <code data-ab-label-b>{cols.b.short}</code></span>
    </div>
    <div class="compare" data-compare>
      <div class="compare-grid" data-compare-grid set:html={compareGridHtml}></div>
      <div class="compare-chart-slot" data-chart-slot set:html={chartSectionHtml}></div>
    </div>
  </section>

  <section class="detail-section">
    <div class="section-title">
      <span class="section-title-num">03</span>
      <span>verification</span>
    </div>
    <table class="other-runs">
      <thead>
        <tr><th>check</th><th>status</th><th>evidence</th></tr>
      </thead>
      <tbody>
        {cols.hasSolverGate && (
          <Fragment>
            <tr>
              <td><span class="other-runs-name">GT self-consistency</span></td>
              <td>
                <span class={`bucket bucket-${gateTone(gateA?.status)} bucket-xs`}>
                  <span class="bucket-label">{gateA ? statusLabel(gateA.status) : '—'}</span>
                </span>
              </td>
              <td class="num">floor {fmt(gateA?.floor)} ({gateA?.metric ?? '—'})</td>
            </tr>
            <tr>
              <td><span class="other-runs-name">solver re-derivation</span></td>
              <td>
                <span class={`bucket bucket-${solverTone} bucket-xs`}>
                  <span class="bucket-label">{gateB ? statusLabel(gateB.status) : '—'}</span>
                </span>
              </td>
              <td class="num">
                {gateB ? `${gateB.n_pass ?? '—'}/${gateB.n_solvers ?? 2} solvers · d=[${(gateB.distances ?? []).map((d) => d == null ? '—' : d.toFixed(3)).join(', ')}] · ${gateB.gate_model ?? ''}` : '—'}
              </td>
            </tr>
          </Fragment>
        )}
        <tr>
          <td><span class="other-runs-name">cross-language ({cols.b.short} vs {cols.a.short})</span></td>
          <td>
            <span class={`bucket bucket-${crossTone} bucket-xs`}>
              <span class="bucket-label">{crosscheck ? statusLabel(crosscheck.status) : '—'}</span>
            </span>
          </td>
          <td class={crosscheck?.status === 'unavailable' ? 'reason-cell' : 'num'}>
            {crosscheck?.status === 'unavailable'
              ? (realizationB?.reason ?? 'documented gap — see realization')
              : crosscheck
                ? `d=${fmt(crosscheck.distance)} ≤ tol ${fmt(crosscheck.tol)} · floors ${fmt(crosscheck.target_floor)}/${fmt(crosscheck.reference_floor)}`
                : '—'}
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <div class="feedback" data-feedback data-collection={corpus} data-dataset-version="problems-v1">
    <div class="feedback-hd">
      <span class="section-title-num">★</span>
      <span>feedback on this problem</span>
      <span class="feedback-rater" data-fb-rater-host hidden>
        as <strong data-fb-rater-name></strong>
        <button type="button" class="link-btn" data-fb-change-name>change</button>
      </span>
    </div>
    <div class="feedback-body">
      <div class="feedback-votes">
        <button type="button" class="vote vote-up" data-vote="up">
          <span aria-hidden="true">▲</span> looks right
        </button>
        <button type="button" class="vote vote-down" data-vote="down">
          <span aria-hidden="true">▼</span> issue
        </button>
      </div>
      <textarea class="feedback-text" data-fb-text rows="2"
        placeholder="optional comment — statement, realization, or verification issues?"></textarea>
      <button type="button" class="btn-primary" data-fb-submit disabled>submit</button>
    </div>
    <div class="feedback-ack" data-fb-ack hidden></div>
    <div class="feedback-prev" data-fb-prev hidden></div>
  </div>

  <script type="application/json" data-source-payload={pid} set:html={JSON.stringify(sourcePayload).replace(/</g, '\\u003c')} />
</section>

<style>
  .stmt-field-hd {
    font: 11.5px var(--font-mono);
    text-transform: uppercase; letter-spacing: .07em;
    color: var(--fg-dim);
    margin: 12px 0 2px;
  }
  .stmt-field-hd:first-child { margin-top: 0; }
  .prompt-card p { margin: 0 0 4px; }

  /* .compare-unavailable / .compare-stored / .rec-* live in global styles.css
     (used in set:html + browse.js). */
  td.reason-cell { font: 12px var(--font-mono); line-height: 1.45; color: var(--fg-dim); white-space: normal; max-width: 56ch; }

  /* Compare-column source pickers: a custom parchment dropdown (NOT native
     <select>, which leaks system chrome on focus) over all sources, so left and
     right are picked independently. Mirrors the corpus picker (.coll-menu). */
  .compare-col-pick { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .src-picker { position: relative; }
  .src-toggle {
    display: inline-flex; align-items: center; gap: 8px; max-width: 32ch;
    font: 11.5px var(--font-mono); color: var(--fg);
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: 6px; padding: 4px 8px; cursor: pointer;
  }
  .src-toggle:hover { border-color: var(--border-strong); }
  .src-toggle[aria-expanded="true"] { border-color: var(--accent); }
  .src-toggle-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .src-caret { color: var(--fg-dim); font-size: 9px; margin-left: auto; }
  .src-menu {
    position: absolute; top: calc(100% + 4px); left: 0; z-index: 30;
    min-width: 100%; max-height: 320px; overflow-y: auto;
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: 6px; box-shadow: 0 6px 20px rgba(0, 0, 0, .12); padding: 4px;
  }
  .src-menu[hidden] { display: none; }
  .src-menu-item {
    display: block; width: 100%; text-align: left; white-space: nowrap;
    font: 11.5px var(--font-mono); color: var(--fg);
    background: none; border: 0; border-radius: 4px;
    padding: 5px 8px; cursor: pointer;
  }
  .src-menu-item:hover { background: var(--accent-bg); }
  .src-menu-item-on { background: var(--accent-bg); color: var(--accent); }
  .compare-col-badge { display: inline-flex; }
</style>
