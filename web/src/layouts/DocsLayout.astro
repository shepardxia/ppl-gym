---
import Layout from './Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<Layout title={`${title} — ppl-gym`}>
  <div class="page-wrap">
    <SiteHeader />
    <main class="docs-prose">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
</Layout>
