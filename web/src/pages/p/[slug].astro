---
// Permalink redirect: /p/<slug> → the problem browser, problem selected.
import { loadAllProblems, problemSlug } from '@/lib/problems';

export const prerender = true;

export async function getStaticPaths() {
  const problems = await loadAllProblems();
  return problems.map((rec) => ({
    params: { slug: problemSlug(rec.problem.problem_id) },
    props: { corpus: rec.corpus, problemId: rec.problem.problem_id },
  }));
}

const { corpus, problemId } = Astro.props as { corpus: string; problemId: string };
const target = `/problems/${corpus}/#${encodeURIComponent(problemId)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{problemId} — ppl-gym</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>{problemId}</a>…</p>
  </body>
</html>
