---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import ProblemTable from '@/components/ProblemTable.astro';
import type { Corpus, ProblemRecord } from '@/lib/problems';
import { loadAllProblemsGrouped, CORPORA, CORPUS_META } from '@/lib/problems';

export const prerender = true;

export async function getStaticPaths() {
  const grouped = await loadAllProblemsGrouped();
  return CORPORA.map((corpus) => ({
    params: { corpus },
    props: { records: grouped[corpus] },
  }));
}

const { corpus } = Astro.params as { corpus: Corpus };
const { records } = Astro.props as { records: ProblemRecord[] };
const meta = CORPUS_META[corpus];
---

<Layout title={`${meta.label} — ppl-gym`}>
  <div class="page-wrap">
    <SiteHeader />

    <main>
      <nav class="crumbs">
        <a href="/problems/">Problems</a><span class="crumbs-sep">›</span><span>{meta.label}</span>
      </nav>
      <h1 class="page-title">{meta.label}</h1>
      <p class="page-lead">
        {meta.description}
        Source: <a href={meta.sourceUrl}>{meta.sourceName}</a> · {records.length} problems.
      </p>
      <ProblemTable records={records} />
    </main>
  </div>
</Layout>
