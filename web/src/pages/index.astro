---
import Layout from '@/layouts/Layout.astro';
import { loadAllProblemsGrouped, CORPORA, CORPUS_META } from '@/lib/problems';
import { loadAllCollections } from '@/lib/atoms';
import { Content as Updates } from '@/docs/updates.md';

export const prerender = true;

const grouped = await loadAllProblemsGrouped();
const legacy = await loadAllCollections();
---

<Layout title="ppl-gym">
  <div class="land">
    <header class="land-top">
      <div class="brand">
        <span class="brand-mark"><span>{'{'}</span><span class="brand-mark-tilde">~</span><span>{'}'}</span></span>
        <span class="brand-name">ppl<span class="brand-name-dim">·</span>gym</span>
      </div>
      <nav class="land-nav">
        <a href="/problems/probmods2/">browse</a>
        <a href="/methodology/">methodology</a>
        <a href="https://github.com/shepardxia/ppl-gym" class="land-nav-ext">GitHub ↗</a>
      </nav>
    </header>

    <section class="land-intro">
      <h1>PPL-gym</h1>
      <p>
        ppl-gym is a dataset of probabilistic programming problems for language
        models, where each problem's solutions are available in multiple PPLs.
      </p>
      <p>
        The multi-PPL solution set is motivated by the observation that every
        PPL, on its own, is low-resource. But the problems translate across
        languages — one set pools across all of them, with answers checkable in
        a shared intermediate representation.
      </p>
    </section>

    <figure class="land-fig">
      <svg viewBox="0 0 900 310" role="img" aria-label="One problem statement; programs in several PPLs; outputs become objects in a Python intermediate representation, compared against the stored ground-truth answer">
        <defs>
          <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0,0 L8,4 L0,8 z" fill="var(--fg-faint)" />
          </marker>
        </defs>

        <!-- statement -->
        <rect x="14" y="92" width="178" height="124" rx="8" fill="var(--bg-elev)" stroke="var(--border-strong)" />
        <text x="30" y="118" font-family="var(--font-mono)" font-size="12" fill="var(--fg)">problem statement</text>
        <g stroke="var(--fg-faint)" stroke-width="3" stroke-linecap="round" opacity="0.5">
          <line x1="30" y1="136" x2="174" y2="136" />
          <line x1="30" y1="150" x2="160" y2="150" />
          <line x1="30" y1="164" x2="174" y2="164" />
          <line x1="30" y1="178" x2="142" y2="178" />
          <line x1="30" y1="192" x2="166" y2="192" />
        </g>

        <!-- programs: real syntax -->
        <g font-family="var(--font-mono)">
          <rect x="276" y="22" width="196" height="70" rx="8" fill="var(--bg-elev)" stroke="var(--border)" />
          <text x="290" y="44" font-size="12" fill="var(--fg)">WebPPL</text>
          <text x="290" y="62" font-size="11" fill="var(--accent)">var x = flip(0.3)</text>
          <text x="290" y="78" font-size="11" fill="var(--accent)">Infer({'{'}…{'}'})</text>

          <rect x="276" y="120" width="196" height="70" rx="8" fill="var(--bg-elev)" stroke="var(--border)" />
          <text x="290" y="142" font-size="12" fill="var(--fg)">Pyro</text>
          <text x="290" y="160" font-size="11" fill="var(--accent)">pyro.sample("x", …)</text>
          <text x="290" y="176" font-size="11" fill="var(--accent)">EmpiricalMarginal(post)</text>

          <rect x="276" y="218" width="196" height="70" rx="8" fill="var(--bg-elev)" stroke="var(--border)" stroke-dasharray="4 4" />
          <text x="290" y="240" font-size="12" fill="var(--fg-dim)">any other PPL</text>
          <text x="290" y="260" font-size="11" fill="var(--fg-faint)">…</text>
        </g>

        <!-- statement -> programs -->
        <g stroke="var(--fg-faint)" stroke-width="1.4" fill="none" marker-end="url(#arr)">
          <path d="M196,132 C 236,114 234,76 270,60" />
          <path d="M196,154 L 270,155" />
          <path d="M196,178 C 236,196 234,236 270,251" />
        </g>

        <!-- intermediate representation: a region; the GT answer lives inside -->
        <rect x="556" y="26" width="330" height="262" rx="14" fill="var(--accent-bg)" stroke="var(--accent)" stroke-dasharray="6 5" />
        <text x="574" y="52" font-family="var(--font-mono)" font-size="12" fill="var(--accent)">intermediate representation · python</text>

        <!-- stored ground-truth answer: filled bars -->
        <g>
          <g fill="var(--accent)">
            <rect x="640" y="170" width="22" height="66" rx="2" />
            <rect x="674" y="128" width="22" height="108" rx="2" />
            <rect x="708" y="192" width="22" height="44" rx="2" />
            <rect x="742" y="206" width="22" height="30" rx="2" />
          </g>
          <line x1="624" y1="236" x2="800" y2="236" stroke="var(--border-strong)" stroke-width="1" />
          <text x="712" y="258" font-family="var(--font-mono)" font-size="11.5" fill="var(--fg-dim)" text-anchor="middle">stored ground-truth answer</text>

          <!-- incoming answers land exactly on the stored bars -->
          <g fill="none" stroke="var(--fg)" stroke-width="1.6">
            <circle cx="651" cy="170" r="5" /><circle cx="685" cy="128" r="5" />
            <circle cx="719" cy="192" r="5" /><circle cx="753" cy="206" r="5" />
          </g>
          <g fill="none" stroke="var(--fg)" stroke-width="1.6" transform="translate(0,0)">
            <path d="M645,158 l6,-8 l6,8 z" /><path d="M679,116 l6,-8 l6,8 z" />
            <path d="M713,180 l6,-8 l6,8 z" /><path d="M747,194 l6,-8 l6,8 z" />
          </g>
          <text x="712" y="92" font-family="var(--font-mono)" font-size="11.5" fill="var(--fg-mid)" text-anchor="middle">○ △ each program's answer, on the same bars</text>
        </g>

        <!-- programs -> into the IR, at the answer -->
        <g stroke="var(--fg-faint)" stroke-width="1.4" fill="none" marker-end="url(#arr)">
          <path d="M476,57 C 530,70 560,110 620,142" />
          <path d="M476,155 C 520,158 570,170 616,182" />
          <path d="M476,253 C 530,240 560,216 618,204" />
        </g>
      </svg>
    </figure>

    <section class="land-corpora">
      {CORPORA.map((c) => {
        const meta = CORPUS_META[c];
        const n = (grouped[c] ?? []).length;
        return (
          <a class="land-corpus" href={`/problems/${c}/`}>
            <span class="land-corpus-name">{meta.label}</span>
            <span class="land-corpus-desc">{meta.description}</span>
            <span class="land-corpus-meta"><b>{n}</b> problems</span>
            <span class="land-corpus-arrow">→</span>
          </a>
        );
      })}
    </section>

    <section class="land-updates">
      <div class="land-updates-hd">updates</div>
      <div class="land-updates-body"><Updates /></div>
    </section>

    <footer class="land-foot">
      <span class="land-foot-grp">
        <span class="land-foot-key">legacy archives</span>
        {legacy.map((c, i) => (
          <Fragment>{i > 0 && ' · '}<a href={`/c/${c.collection.slug}`}>{c.collection.label}</a></Fragment>
        ))}
      </span>
    </footer>
  </div>
</Layout>

<style>
  .land { max-width: 980px; margin: 0 auto; padding: 26px 32px 64px; }

  .land-top {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
    padding-bottom: 14px; margin-bottom: 36px;
    border-bottom: 1px solid var(--border);
  }
  .land-nav { display: flex; gap: 18px; font: 13px var(--font-mono); }
  .land-nav a { color: var(--fg-dim); text-decoration: none; }
  .land-nav a:hover { color: var(--accent); }
  .land-nav-ext { color: var(--fg-faint) !important; }

  .land-intro h1 {
    font: 600 30px var(--font-prose);
    letter-spacing: -.01em;
    color: var(--fg);
    margin: 0 0 14px;
  }
  .land-intro p {
    font: 16.5px/1.6 var(--font-prose);
    color: var(--fg-mid);
    max-width: 760px;
    margin: 0 0 12px;
  }

  .land-fig { margin: 30px 0 40px; }
  .land-fig svg { width: 100%; height: auto; display: block; }

  .land-corpora { margin-bottom: 40px; }
  .land-corpus {
    display: grid;
    grid-template-columns: 130px 1fr auto 24px;
    gap: 18px; align-items: baseline;
    padding: 12px 6px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .land-corpus:first-of-type { border-top: 1px solid var(--border); }
  .land-corpus:hover { background: var(--hover); }
  .land-corpus-name { font: 600 16px var(--font-prose); color: var(--fg); }
  .land-corpus-desc { font: 14px/1.5 var(--font-prose); color: var(--fg-mid); }
  .land-corpus-meta { font: 12.5px var(--font-mono); color: var(--fg-dim); white-space: nowrap; }
  .land-corpus-arrow { color: var(--fg-faint); }
  .land-corpus:hover .land-corpus-arrow { color: var(--accent); }
  @media (max-width: 720px) { .land-corpus { grid-template-columns: 1fr auto; } .land-corpus-desc { display: none; } }

  .land-updates { margin-bottom: 36px; }
  .land-updates-hd {
    font: 12px var(--font-mono); text-transform: uppercase; letter-spacing: .08em;
    color: var(--fg-dim); margin-bottom: 10px;
    padding-bottom: 6px; border-bottom: 1px solid var(--border);
  }
  .land-updates-body :global(p) {
    font: 14.5px/1.6 var(--font-prose);
    color: var(--fg-mid);
    margin: 0 0 8px;
  }
  .land-updates-body :global(strong) { color: var(--fg); }
  .land-updates-body :global(a) { color: var(--accent); }

  .land-foot {
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font: 12.5px var(--font-mono); color: var(--fg-dim);
  }
  .land-foot a { color: var(--fg-dim); }
  .land-foot a:hover { color: var(--accent); }
  .land-foot-key { color: var(--fg-faint); text-transform: uppercase; letter-spacing: .07em; margin-right: 8px; }
</style>
