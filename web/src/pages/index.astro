---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { datasetStats, CORPUS_META } from '@/lib/problems';

export const prerender = true;

const stats = await datasetStats();
---

<Layout title="ppl-gym — verified probabilistic-programming problems">
  <div class="page-wrap">
    <SiteHeader active="none" />

    <main class="landing">
      <section class="hero">
        <h1>Probabilistic-programming problems with machine-verified ground truths.</h1>
        <p class="hero-lead">
          ppl-gym is a benchmark for evaluating how well language models write
          probabilistic programs. The unit is a <em>problem</em>, not a program:
          a language-neutral statement that fully determines its answer, paired
          with ground-truth realizations in each supported PPL. Nothing ships on
          trust — every ground truth is gated by independent re-derivation and
          cross-language agreement.
        </p>
      </section>

      <section class="stat-strip">
        <div class="stat"><span class="stat-n">{stats.total}</span><span class="stat-k">problems</span></div>
        <div class="stat"><span class="stat-n">{stats.byCorpus.length}</span><span class="stat-k">source corpora</span></div>
        <div class="stat"><span class="stat-n">{stats.webpplVerified}/{stats.total}</span><span class="stat-k">WebPPL solver-verified</span></div>
        <div class="stat"><span class="stat-n">{stats.pyroVerified}/{stats.total}</span><span class="stat-k">Pyro cross-verified</span></div>
      </section>

      <section class="landing-section">
        <div class="section-title">
          <span class="section-title-num">01</span>
          <span>how the dataset is verified</span>
        </div>
        <ul class="claims">
          <li>
            <strong>Statements determine answers.</strong> Each problem states its
            priors, data, and query in prose precise enough that any competent
            solver, in any PPL, converges to the same answer — enforced by a gate,
            not by eyeballing.
          </li>
          <li>
            <strong>Tolerances are measured, never authored.</strong> Each problem's
            acceptance threshold is derived from its own ground truth's seed-to-seed
            noise. Deterministic problems demand near-exact answers; stochastic ones
            get exactly the slack their sampling noise justifies.
          </li>
          <li>
            <strong>Languages check each other.</strong> Every Pyro realization must
            agree with the WebPPL ground truth within both sides' measured noise —
            a stronger check than solver consensus, which shares the ground truth's
            blind spots.
          </li>
        </ul>
        <p class="landing-more">Details: <a href="/methodology/">methodology</a>.</p>
      </section>

      <section class="landing-section">
        <div class="section-title">
          <span class="section-title-num">02</span>
          <span>browse the problems</span>
        </div>
        <div class="corpus-cards">
          {stats.byCorpus.map(({ corpus, count }) => {
            const meta = CORPUS_META[corpus];
            return (
              <a class="corpus-card" href={`/problems/${corpus}/`}>
                <div class="corpus-card-hd">
                  <span class="corpus-card-name">{meta.label}</span>
                  <span class="corpus-card-count">{count} problems</span>
                </div>
                <p class="corpus-card-desc">{meta.description}</p>
                <span class="corpus-card-src">{meta.sourceName}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="landing-section">
        <div class="section-title">
          <span class="section-title-num">03</span>
          <span>for reviewers</span>
        </div>
        <p class="landing-text">
          This site doubles as the review surface for collaborating PPL experts:
          every problem page shows the statement, both realizations, and the full
          verification evidence, and takes feedback directly — see the
          <a href="/reviewing/">reviewing guide</a>. Recent changes are on the
          <a href="/updates/">updates</a> page; the corpus and harness live at
          <a href="https://github.com/shepardxia/ppl-gym">shepardxia/ppl-gym</a>.
        </p>
      </section>
    </main>
  </div>
</Layout>
